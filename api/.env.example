# Copy to .env and fill in. Server-side only — never exposed to the browser.

# Neon Postgres connection string (Dashboard → Connect → Connection string).
DATABASE_URL=

# Port to listen on. Hosts (Railway, Render, …) inject their own; 3001 is the
# local fallback the frontend's .env.example points at.
PORT=3001

# CORS origin — the only browser origin allowed to call this API. Server-to-server
# callers (curl, the cron scheduler) send no Origin and are unaffected.
FRONTEND_URL=http://localhost:3000

# This API's own public address. Email confirmation links are built from it, so
# it must be reachable by whoever clicks them — not localhost, once deployed.
API_URL=http://localhost:3001

# Privy (Dashboard → App settings). The secret verifies access tokens server-side;
# the caller's wallet address is trusted from the verified JWT, never the body.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Resend API key for transactional email (confirmation + expiry reminders).
# Without a verified sending domain, Resend only delivers to the inbox that owns
# the key, and the sender must stay onboarding@resend.dev.
RESEND_API_KEY=

# Shared secret for POST /api/v1/cron/expiry — the scheduler sends it as the
# x-cron-secret header. If unset, the route stays closed rather than open.
CRON_SECRET=
