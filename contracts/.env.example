# copy to .env and fill in. .env is gitignored.

# RPC endpoints (Alchemy / public)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETH_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Etherscan v2 — one key verifies across Base + Ethereum (etherscan.io/apidashboard)
ETHERSCAN_API_KEY=

# Deployer: cast keystore account name + its address. BOTH are needed (see Makefile / deployments.md).
ACCOUNT=dev
SENDER=0x7eF78e0ef51A18Ce23269707CA3A256b69F884c1

# Current Base Sepolia deployment (used by make mint/approve). Fill in after deploying.
MANAGER=
MOCK_USDC=
