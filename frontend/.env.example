# Copy to .env and fill in. NEXT_PUBLIC_* vars are inlined into the browser
# bundle at BUILD time — never put a real secret behind this prefix.

# Alchemy (or any) Base Sepolia RPC. Optional: if unset, wagmi falls back to
# the chain's default public RPC (rate-limited, shared).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Where the Hono API listens, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# From the Privy dashboard (App settings). Public identifiers, not secrets.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
