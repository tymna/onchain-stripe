# Patterns are hierarchical: no leading "/" matches at any depth,
# so this single root file covers every package (api, frontend, …).

# ---- dependencies ---- #
node_modules/
.pnpm-store/

# ---- secrets (keep .env.example committed as a template) ---- #
.env
.env.*
!.env.example

# ---- build output / caches ---- #
dist/
.next/
out/
cache/
*.tsbuildinfo

# ---- logs ---- #
*.log
pnpm-debug.log*

# ---- local notes (not part of the public repo) ---- #
TODO.md

# ---- os / editor ---- #
.DS_Store
.idea/
.vscode/
*.swp
